#!/bin/bash
#PBS -q regular-g
#PBS -l select=1:mpiprocs=1:ompthreads=8
#PBS -l walltime=24:00:00
#PBS -W group_list=gj26
#PBS -N llmsim-gh200-full
#PBS -j oe

set -euo pipefail

module purge
module load singularity/4.2.1

BASE=/work/gj26/b20122/llmservingsim-gh200
REPO="$BASE/LLMServingSim"
SIF="$BASE/containers/vllm-v0.19.0-aarch64-cu130-ubuntu2404.sif"

HF_HOME="$BASE/huggingface"
PYDEPS="$BASE/python-packages/pandas-only"
SINGULARITY_CACHEDIR="$BASE/.singularity-cache"
SINGULARITY_TMPDIR="$BASE/.singularity-tmp"

CONTAINER_PYTHON=python3

export SINGULARITY_CACHEDIR
export SINGULARITY_TMPDIR
export TMPDIR="$SINGULARITY_TMPDIR"

mkdir -p "$HF_HOME/hub"
mkdir -p "$SINGULARITY_CACHEDIR"
mkdir -p "$SINGULARITY_TMPDIR"
mkdir -p "$REPO/logs"

cd "$REPO"

echo "========================================"
echo "LLMServingSim GH200 full profiling"
echo "========================================"
echo "Date: $(date -Is)"
echo "PBS_JOBID: ${PBS_JOBID:-unknown}"
echo "PBS_O_WORKDIR: ${PBS_O_WORKDIR:-unknown}"
echo "Host: $(hostname)"
echo "Repository: $REPO"
echo "Container: $SIF"
echo

if [ ! -s "$SIF" ]; then
  echo "ERROR: SIF file does not exist or is empty:"
  echo "$SIF"
  exit 1
fi

if [ ! -d "$REPO/profiler" ]; then
  echo "ERROR: profiler directory was not found:"
  echo "$REPO/profiler"
  exit 1
fi

echo "=== CPU architecture ==="
uname -m
uname -a
echo

echo "=== GPU information ==="
nvidia-smi
echo

nvidia-smi \
  --query-gpu=index,name,memory.total,driver_version \
  --format=csv
echo

echo "=== Filesystem information ==="
df -h "$BASE"
df -h /dev/shm
echo

echo "=== Repository revision ==="
git rev-parse HEAD
git status --short
echo

RUN=(
  singularity exec
  --nv
  --bind "$BASE:$BASE"
  --bind "$REPO:/workspace"
  --pwd /workspace
  --env "HF_HOME=$HF_HOME"
  --env "HF_HUB_CACHE=$HF_HOME/hub"
  --env "HF_TOKEN=${HF_TOKEN:-}"
      --env "CUDA_VISIBLE_DEVICES=0"
  --env "PYTHONPATH=/workspace:$PYDEPS"
  --env "PYTHONNOUSERSITE=1"
  "$SIF"
)

echo "=== Container Python and dependency check ==="

"${RUN[@]}" "$CONTAINER_PYTHON" -c '
import platform
import sys
import numpy
import huggingface_hub
import transformers
import torch
import os
import vllm

print("architecture:", platform.machine())
print("python:", sys.version)
print("python executable:", sys.executable)
print("numpy:", numpy.__version__)
print("huggingface-hub:", huggingface_hub.__version__)
print("transformers:", transformers.__version__)
print("torch:", torch.__version__)
print("vllm:", vllm.__version__)

from vllm import LLM
print("from vllm import LLM: OK")
'
echo

echo "=== CUDA environment ==="

"${RUN[@]}" "$CONTAINER_PYTHON" -c '
import torch
import os

print("CUDA_VISIBLE_DEVICES:", os.environ.get("CUDA_VISIBLE_DEVICES"))
print("CUDA runtime:", torch.version.cuda)
print("CUDA available:", torch.cuda.is_available())
print("CUDA device count:", torch.cuda.device_count())

if not torch.cuda.is_available():
    raise RuntimeError("CUDA is not available inside the container")

props = torch.cuda.get_device_properties(0)

print("GPU:", torch.cuda.get_device_name(0))
print("GPU memory GiB:", props.total_memory / 2**30)
'
echo

echo "=== Hugging Face token check ==="

if [ -n "${HF_TOKEN:-}" ]; then
  echo "HF_TOKEN is set."
else
  echo "ERROR: HF_TOKEN is not set."
  echo "Submit using: qsub -v HF_TOKEN miyabi_profile_smoke.pbs"
  exit 1
fi
echo

echo "=== Prepare workloads ==="

"${RUN[@]}" "$CONTAINER_PYTHON" \
  experiments/2026-07-31_new_workload/scripts/prepare_workloads.py
echo

echo "=== Validate workloads ==="

"${RUN[@]}" "$CONTAINER_PYTHON" \
  experiments/2026-07-31_new_workload/scripts/validate.py
echo

echo "=== Start GH200 full profile ==="

"${RUN[@]}" "$CONTAINER_PYTHON" -m profiler profile \
  meta-llama/Llama-3.1-8B \
  --hardware GH200 \
  --tp 1 \
  --dtype bfloat16 \
  --kv-cache-dtype auto \
  --max-num-batched-tokens 2048 \
  --max-num-seqs 256 \
  --attention-max-kv 16384 \
  --measurement-iterations 3 \
      --force \
  2>&1 | tee "$REPO/logs/profile-gh200-full-${PBS_JOBID}.log"
echo

echo "=== Generated profile files ==="

find \
  profiler/perf/GH200/meta-llama/Llama-3.1-8B \
  -maxdepth 4 \
  -type f \
  -print
echo

PROFILE_DIR=""

for candidate in \
  profiler/perf/GH200/meta-llama/Llama-3.1-8B/bfloat16/tp1 \
  profiler/perf/GH200/meta-llama/Llama-3.1-8B/bf16/tp1
do
  if [ -d "$candidate" ]; then
    PROFILE_DIR="$candidate"
    break
  fi
done

if [ -z "$PROFILE_DIR" ]; then
  echo "ERROR: Profile output directory was not found."
  find profiler/perf/GH200 -maxdepth 6 -type d -print || true
  exit 1
fi

echo "=== Profile validation ==="
echo "Profile directory: $PROFILE_DIR"

test -s "$PROFILE_DIR/attention.csv"
echo "attention.csv: OK"

test -s "$PROFILE_DIR/dense.csv"
echo "dense.csv: OK"

test -s "$PROFILE_DIR/per_sequence.csv"
echo "per_sequence.csv: OK"

echo
echo "=== Profile file sizes ==="
ls -lh "$PROFILE_DIR"

echo
echo "========================================"
echo "Full profile completed successfully"
echo "Date: $(date -Is)"
echo "========================================"
