# Copy this file to config.env and replace every value marked REPLACE_ME.
MIYABI_ENDPOINT=http://127.0.0.1:18000/v1
MIYABI_MODEL=meta-llama/Llama-3.1-8B-Instruct
MIYABI_API_KEY=

# Miyabi deployment metadata recorded with every run.
MIYABI_GPU_MODEL=REPLACE_ME
MIYABI_NODE_COUNT=8
MIYABI_GPUS_PER_NODE=1
MIYABI_REPLICA_COUNT=8
MIYABI_TENSOR_PARALLEL_SIZE=1
MIYABI_ROUTER_POLICY=REPLACE_ME
MIYABI_VLLM_VERSION=REPLACE_ME
MIYABI_CONTAINER_DIGEST=REPLACE_ME
MIYABI_MODEL_REVISION=REPLACE_ME

# Client settings kept equal to the accepted Azure v3 runs.
MAX_CLIENT_CONCURRENCY=512
CONNECT_TIMEOUT_S=10
FIRST_TOKEN_TIMEOUT_S=120
REQUEST_TIMEOUT_S=1800
WARMUP_REQUESTS=1
FAILURE_RETRIES=1
LAUNCH_LAG_P99_THRESHOLD_MS=100
